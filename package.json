{
  "name": "dsh-four-images-workbench",
  "version": "0.2.0",
  "private": true,
  "description": "四象工作台：四象模型系列插件的统一入口（了解 / 安装 / 状态 / 使用）",
  "keywords": ["dsh", "dsh-bundle", "four-images", "management", "workbench"],
  "license": "MIT",
  "author": "DaiGuobin-CSU <daiguobin@csu.edu.cn>",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "DESIGN.md",
    "INTEGRATION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
