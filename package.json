{
  "name": "dsh-workbench-four-images-model",
  "version": "0.3.0",
  "description": "四象工作台：四象模型插件的运行容器（外壳 / 导航 / 通用管理 / 扩展点），具体内容由各插件提供",
  "keywords": ["dsh", "dsh-bundle", "four-images", "management", "workbench"],
  "license": "MIT",
  "author": "DaiGuobin-CSU <daiguobin@csu.edu.cn>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RootAndSource/dsh-workbench-four-images-model.git"
  },
  "homepage": "https://github.com/RootAndSource/dsh-workbench-four-images-model#readme",
  "bugs": {
    "url": "https://github.com/RootAndSource/dsh-workbench-four-images-model/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "DESIGN.md",
    "INTEGRATION.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
